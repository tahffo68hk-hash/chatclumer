# 复制为环境变量，或在界面里写入服务器本地 secrets（权限 600）。
# 不要把真实密钥提交到 Git。留空时房间使用 DEMO，合成回复会标明「非真实模型」。
# 可能计费的云端调用默认关闭。只有确认该接口零费用后，才把 ALLOW_PAID_PROVIDERS 设为 1。

OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 默认 0。未知单价的云端模型在打开前不会被调用。
ALLOW_PAID_PROVIDERS=0

# QQ 官方机器人。缺任一项时状态为 BLOCKED_EXTERNAL，不会连接真实群。
QQ_APP_ID=
QQ_BOT_TOKEN=
QQ_BOT_SECRET=

# 只接受微信公众平台或企业微信。不要填写个人微信。
WECHAT_OA_APPID=
WECHAT_OA_TOKEN=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
